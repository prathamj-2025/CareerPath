# Copy to .env for local development with `vercel dev`.
# In production these are set in Vercel, under Settings > Environment Variables.
# Never commit the real key. .env is gitignored.

# --- Google Gemini (has a free tier) ---
AI_API_KEY=your-gemini-key
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-3.8-flash

# --- OpenAI ---
# AI_API_KEY=sk-your-openai-key
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini

# Any provider that serves the OpenAI chat-completions format works. Only these
# three values change. Get a Gemini key and the current model ids from
# aistudio.google.com, and an OpenAI key from platform.openai.com.

# --- Sign in with Google (optional) ---
# OAuth client ID from Google Cloud Console (APIs & Services > Credentials > OAuth client ID,
# type "Web application"). Add your site, e.g. https://career-path-pj.vercel.app, under
# "Authorized JavaScript origins". This value is public by design; leave it unset to hide the button.
# GOOGLE_CLIENT_ID=1234567890-abc123.apps.googleusercontent.com

# Real accounts (Supabase). Optional: api/config.js already holds this project's public values.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# SUPABASE_GOOGLE=1          # show "Continue with Google" once the Google provider is set up in Supabase
# CP_DEMO=1                  # force the browser-only demo (tests)
# SUPABASE_SERVICE_ROLE_KEY=sb_secret_...   # SECRET. Grades exams, projects and weekly challenges, and saves the results. Vercel settings only, never the repo.

# Address shown on the Help, FAQ and Contact pages (default careerpath531@gmail.com)
SUPPORT_EMAIL=careerpath531@gmail.com

# Optional tuning for the AI model
# AI_MAX_TOKENS=2500          # reply limit; thinking models count their thinking against it
# AI_REASONING_EFFORT=low     # for thinking models such as Gemini 3.x; leave unset for other models
